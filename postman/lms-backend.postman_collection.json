{
  "info": {
    "name": "Advanced LMS Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api" },
    { "key": "accessToken", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "moduleId", "value": "" },
    { "key": "assignmentId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teacher One\",\n  \"email\": \"teacher@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"TEACHER\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh" }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        { "name": "List Courses", "request": { "method": "GET", "url": "{{baseUrl}}/courses?search=&page=1&limit=10" } },
        { "name": "Get Course", "request": { "method": "GET", "url": "{{baseUrl}}/courses/{{courseId}}" } },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"NestJS Advanced\",\n  \"description\": \"Professional backend course\",\n  \"price\": 49.99,\n  \"thumbnail\": \"https://example.com/thumb.jpg\",\n  \"category\": \"Backend\",\n  \"level\": \"INTERMEDIATE\"\n}"
            },
            "url": "{{baseUrl}}/courses"
          }
        },
        {
          "name": "Update Course",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"NestJS Masterclass\"\n}" },
            "url": "{{baseUrl}}/courses/{{courseId}}"
          }
        },
        {
          "name": "Delete Course",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/courses/{{courseId}}"
          }
        }
      ]
    },
    {
      "name": "Learning",
      "item": [
        {
          "name": "Enroll",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/courses/{{courseId}}/enroll"
          }
        },
        {
          "name": "My Courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/my-courses"
          }
        },
        {
          "name": "Create Module",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Introduction\",\n  \"description\": \"Start here\",\n  \"order\": 1\n}" },
            "url": "{{baseUrl}}/courses/{{courseId}}/modules"
          }
        },
        {
          "name": "List Modules",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/courses/{{courseId}}/modules"
          }
        },
        {
          "name": "Create Lesson",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Lesson 1\",\n  \"videoUrl\": \"https://example.com/video.mp4\",\n  \"content\": \"Lesson content\",\n  \"order\": 1\n}" },
            "url": "{{baseUrl}}/modules/{{moduleId}}/lessons"
          }
        },
        {
          "name": "List Lessons",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/modules/{{moduleId}}/lessons"
          }
        }
      ]
    },
    {
      "name": "Assignments and Results",
      "item": [
        {
          "name": "Submit Assignment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "answer",
                  "value": "My assignment answer",
                  "type": "text"
                },
                {
                  "key": "video",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{baseUrl}}/modules/{{moduleId}}/assignments"
          }
        },
        {
          "name": "My Assignments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/assignments/my"
          }
        },
        {
          "name": "Grade Assignment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"score\": 95,\n  \"feedback\": \"Excellent work\"\n}" },
            "url": "{{baseUrl}}/assignments/{{assignmentId}}/grade"
          }
        },
        {
          "name": "All Results",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/results"
          }
        },
        {
          "name": "My Results",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/results/me"
          }
        }
      ]
    }
  ]
}
